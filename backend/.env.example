# === Aplikasi ===
APP_ENV=dev
APP_PORT=8080
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# === Database (XAMPP MySQL default) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=kaliaja_coffe

# === Auth / Session ===
# HANYA untuk development. Di produksi WAJIB pakai rahasia unik hasil generator
# (minimal 32 karakter). Nilai contoh ini ditolak saat APP_ENV=production.
JWT_SECRET=dev-only-change-this-secret-kaliaja-coffe-2026
JWT_EXPIRY_HOURS=24
# true di produksi (HTTPS). false hanya untuk development HTTP.
COOKIE_SECURE=false

# === Upload ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# === Reset password ===
# Jika SMTP_HOST kosong, token reset hanya dicetak di log terminal (mode dev).
# Di produksi SMTP_HOST wajib diisi; token TIDAK akan dicetak ke log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@kaliaja.coffe

# === Seed akun awal (dijalankan via: go run ./cmd/server -seed) ===
# Password contoh di bawah DITOLAK saat APP_ENV=production.
SEED_ADMIN_EMAIL=admin@kaliaja.coffe
SEED_ADMIN_PASSWORD=Admin123!
SEED_BOS_EMAIL=bos@kaliaja.coffe
SEED_BOS_PASSWORD=Bos123!

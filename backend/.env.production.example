# === Salin ke backend/.env di server produksi ===
# Semua nilai WAJIB diganti. Jangan pernah commit file .env yang sudah diisi.

APP_ENV=production
APP_PORT=8080
APP_URL=https://kaliaja.coffe
ALLOWED_ORIGIN=https://kaliaja.coffe

# === Database (user khusus aplikasi, BUKAN root) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kaliaja_app
DB_PASS=<password-db-yang-kuat-dan-unik>
DB_NAME=kaliaja_coffe
# Kosongkan untuk MySQL lokal. Untuk TiDB Cloud / DB dengan TLS wajib: true
DB_TLS=

# === Auth / Session ===
# Minimal 32 karakter, hasil generator (mis. openssl rand -hex 32).
JWT_SECRET=<rahasia-unik-minimal-32-karakter>
JWT_EXPIRY_HOURS=24
COOKIE_SECURE=true
# VPS: 127.0.0.1. Render/PaaS: 0.0.0.0/0,::/0 (proxy platform menimpa XFF).
TRUSTED_PROXIES=127.0.0.1

# === Upload ===
# local = file di UPLOAD_DIR (butuh disk persisten / VPS)
# cloudinary = file ke Cloudinary (wajib untuk Render gratis yang disk-nya tidak persisten)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kaliaja

# === Reset password (WAJIB diisi di produksi) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@kaliaja.coffe
SMTP_PASS=<password-smtp>
SMTP_FROM=no-reply@kaliaja.coffe

# === Akun awal (hanya dipakai saat -seed, lalu password bisa diganti) ===
SEED_ADMIN_EMAIL=admin@kaliaja.coffe
SEED_ADMIN_PASSWORD=<password-admin-baru-yang-kuat>
SEED_BOS_EMAIL=bos@kaliaja.coffe
SEED_BOS_PASSWORD=<password-bos-baru-yang-kuat>
